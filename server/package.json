{
  "name": "note-service-server",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "start": "NODE_ENV=production node dist/src/main.js",
    "start:deploy": "bash ./start.sh",
    "start:dev": "NODE_ENV=development node ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.6.2",
    "markdown-it": "^14.1.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.1",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
